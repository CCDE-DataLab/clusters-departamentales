\RequirePackage[T1]{fontenc}
\RequirePackage{lmodern,microtype,graphicx,booktabs,amsmath,amssymb,ragged2e}
\RequirePackage[most]{tcolorbox}
\definecolor{ccdenavy}{HTML}{0A1E40}
\definecolor{ccdeaccent}{HTML}{0077B6}
\definecolor{ccdeice}{HTML}{EBF7FC}
\definecolor{warn}{HTML}{CA5D36}
\definecolor{okgreen}{HTML}{16805F}
\definecolor{purplex}{HTML}{784EA0}
\setbeamertemplate{navigation symbols}{}
\setbeamercolor{normal text}{fg=ccdenavy,bg=white}
\setbeamercolor{frametitle}{fg=ccdenavy,bg=white}
\setbeamercolor{structure}{fg=ccdeaccent}
\setbeamerfont{frametitle}{size=\large,series=\bfseries}
\setbeamersize{text margin left=.65cm,text margin right=.65cm}
\setbeamertemplate{frametitle}{\vspace{.20cm}\insertframetitle\par\vspace{.12cm}}
\newcommand{\ccdefootlabel}{CCDE | Estructura productiva y recuperación regional}
\setbeamertemplate{footline}{\hspace{.65cm}\raisebox{.18cm}{\scriptsize\color{ccdeaccent}\ccdefootlabel}\hfill\raisebox{.18cm}{\scriptsize\color{ccdenavy}\insertframenumber\hspace{.65cm}}}
\newcommand{\source}[1]{\vfill{\RaggedRight\fontsize{6.5}{8}\selectfont\color{ccdeaccent}Fuente: #1\par}\vspace{.08cm}}
\newtcolorbox{keybox}[1][]{colback=ccdeice,colframe=ccdeice,boxrule=0pt,arc=1mm,fontupper=\raggedright,left=3mm,right=3mm,top=2mm,bottom=2mm,#1}
\newcommand{\chartframe}[4]{\begin{frame}[t]{#1}\begin{center}\includegraphics[width=\textwidth,height=4.75cm,keepaspectratio]{#2}\end{center}\vspace{-.12cm}\begin{minipage}{\textwidth}\small\raggedright #3\end{minipage}\source{#4}\end{frame}}
\newcommand{\metric}[3]{\begin{keybox}\textcolor{#3}{\fontsize{28}{31}\selectfont\bfseries #1}\par\vspace{.10cm}\small #2\end{keybox}}
% Recursos de síntesis ejecutiva y notas metodológicas con la paleta CCDE.
\newtcolorbox{simplebox}[1][]{enhanced,colback=white,colframe=ccdeice,boxrule=.6pt,borderline west={3pt}{0pt}{ccdeaccent},arc=1mm,fontupper=\raggedright\small,left=3mm,right=3mm,top=1.5mm,bottom=1.5mm,#1}
\newcommand{\nota}[1]{\textcolor{ccdeaccent}{\bfseries #1:}\ }
\newcommand{\termino}[2]{{\small\textcolor{ccdeaccent}{\bfseries #1}}\par{\footnotesize #2}\par\vspace{.03cm}}

